{
  "name": "Daily Lulu Setup Reminder",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_lulu_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "remind-lulu-setup",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send reminder",
            "description": "Nudge admins if Lulu keys are missing"
          }
        }
      }
    ]
  },
  "description": "Emails the app admins every day to add Lulu API credentials until they are configured",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}